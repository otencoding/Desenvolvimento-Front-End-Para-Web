function criarTabuleiro()
{
    let tabuleiro = [];
    for(let i = 0; i < 3; i++)
    {
        tabuleiro [i] = [" "," "," "];
    }
    return tabuleiro;
}
function marcar (tabuleiro, linha, coluna, jogador)
{
    if (tabuleiro[linha][coluna] === "")
    {
        tabuleiro[linha][coluna] = jogador;
        return true;
    }
    return false;
}
function exibirTabuleiro(tabuleiro)
{
    for (let i = 0; i < 3; i++)
    {
        console.log(tabuleiro[i].join(" | "));
    }
}

