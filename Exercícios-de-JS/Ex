function serieFibonacci(num)
{
    let fibo = [0, 1];
    while(fibo.length < num)
    {
        fibo.push(fibo[fibo.length - 1] + fibo[fibo.length - 2]);
    }
    return fibo.slice(0, num);
}
console.log(serieFibonacci(20));

