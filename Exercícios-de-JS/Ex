function todosIndices(vetor, num)
{
    let indice = [];
    for(let i = 0; i < vetor.length; i++)
    {
        if(vetor[i] === num)
        {
            indice.push[i];
        }
    }
    return indice;
}
console.log(todosIndices([1, 2, 3, 5, 2, 8, 4]), 2);

